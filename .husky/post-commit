#!/usr/bin/env sh
# One version tag per commit: v0.0.1, v0.0.2, ... (patch bump).
# The pre-commit hook wrote that version into the tracked `VERSION` file, so the
# tag and the version baked into image builds are always the same.
# Prints the commit feedback line after every successful commit.

GIT_DIR=$(git rev-parse --git-dir)

# History rewriting must not create per-commit tags.
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; then
  exit 0
fi

# HEAD already tagged - do not double-tag the same commit.
if [ -n "$(git tag --points-at HEAD)" ]; then
  exit 0
fi

version=$(tr -d '[:space:]' < VERSION 2>/dev/null || true)

if [ -z "$version" ]; then
  echo "post-commit: VERSION is missing or empty - run 'npm run version:file' and amend" >&2
  exit 1
fi

if ! printf '%s' "$version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "post-commit: VERSION='$version' is not a vMAJOR.MINOR.PATCH version" >&2
  exit 1
fi

if git tag -a "$version" -m "$version" >/dev/null 2>&1; then
  short=$(git rev-parse --short HEAD)
  echo "commit $short successful - version $version (run 'npm run release:push' to share it)"
else
  echo "post-commit: tag $version already exists - run 'npm run version:file' and amend" >&2
  exit 1
fi
