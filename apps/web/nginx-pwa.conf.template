server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Uploads of the report form (photos).
    client_max_body_size ${UPLOAD_MAX_BYTES};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/wasm image/svg+xml;

    # Docker's embedded DNS. The API host is resolved per request (see the
    # $api_upstream variable below), so nginx starts even when the API
    # container is not on the network yet — a deployment panel may create the
    # services one by one. Until the API is reachable /api/ answers 502.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location /api/ {
        # A variable keeps the host resolution out of the startup phase. There
        # is no URI part, so the original request URI (including "/api/") is
        # passed to the API unchanged.
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
