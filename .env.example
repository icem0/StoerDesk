# StörDesk — Umgebungsvariablen
# Kopieren nach .env und anpassen. .env wird nicht eingecheckt.

# --- Datenbank ---
POSTGRES_DB=stoerdesk
POSTGRES_USER=stoerdesk
POSTGRES_PASSWORD=stoerdesk
DATABASE_URL=postgres://stoerdesk:stoerdesk@db:5432/stoerdesk
DB_LOG_LEVEL=warning

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=bitte-ersetzen-mindestens-32-zeichen-lange
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Seed ---
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=bitte-ersetzen

# --- Push / Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# --- E-Mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=stoerdesk@example.org

# --- Push-Kanal ntfy ---
NTFY_URL=
NTFY_TOPIC=

# --- Push-Kanal Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Uploads ---
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760
