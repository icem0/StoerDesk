# StörDesk — environment variables (template)
#
# This file documents EVERY variable the stack understands.
# Create your own file with generated secrets:
#
#     npm run env:create            # writes .env (never committed)
#
# Docker Compose reads `.env` automatically, so the compose file never has to
# be edited. The API also falls back to `.env` when it runs outside a
# container (npm run dev).
#
# Everything has a working default except the secrets marked REQUIRED.

# ---------------------------------------------------------------------------
# Project / Compose
# ---------------------------------------------------------------------------
# Name of the Compose project. Prefixes container, network and volume names.
COMPOSE_PROJECT_NAME=stoerdesk

# Timezone used by the containers (logs, timestamps).
TZ=Europe/Berlin

# Build context for the images.
#
# The default builds from the local checkout, so a normal `git clone` starts
# exactly the code you have in front of you.
#
# A deployment panel that clones the repository itself sets the Git URL:
#   IMAGE_BUILD_CONTEXT=https://github.com/icem0/StoerDesk.git#main
# The panel then always finds the Dockerfile, no matter what sits in the
# project folder. A developer machine keeps the default `.`.

IMAGE_BUILD_CONTEXT=.

# ---------------------------------------------------------------------------
# Images (pin a version for reproducible deployments)
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine

# ---------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------
# The stack publishes exactly ONE port: the web frontend (nginx). It serves the
# PWA and proxies /api/ to the API over the internal `backend` network, so the
# API and Postgres need no host port and can never collide with other projects
# on the same Docker host.
#
# Host port of the web frontend. Open this one in the browser.
# 3080 instead of the usual 8080: 8080 is already taken by many other tools.
WEB_PORT=3080

# Address the web frontend is bound to on the host.
WEB_BIND_ADDRESS=0.0.0.0

# Host port of the Postgres instance. Only used by docker-compose.dev.yml —
# the production stack keeps Postgres internal.
POSTGRES_PORT=5432

# Host port and bind address of the API. Never used by the production stack;
# they apply only to the optional debug override, which publishes the API for
# direct curl/monitoring:
#   docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d
API_PUBLISHED_PORT=3000
API_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Database name, user and password of the StoerDesk database.
# POSTGRES_PASSWORD is REQUIRED. `npm run env:create` generates a URL-safe
# value; the API URL-encodes credentials in the connection URL.
POSTGRES_DB=stoerdesk
POSTGRES_USER=stoerdesk
POSTGRES_PASSWORD=change-me-postgres

# Connection URL used when the API runs on the host (npm run dev, tooling).
# Inside the container Compose passes the parts below (DATABASE_HOST and
# friends) instead: the API URL-encodes the credentials, so a password with
# characters like "#", "@" or "!" works.
DATABASE_URL=postgres://stoerdesk:change-me-postgres@localhost:5432/stoerdesk

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# "development" | "test" | "production". Compose always runs "production".
NODE_ENV=development

# Interface the API binds to inside its container.
API_HOST=0.0.0.0

# Port the API listens on inside its container. The web frontend proxies
# /api/ to this port, so change it here only if you adapt the proxy too.
API_PORT=3000

# Log level of the API: fatal | error | warn | info | debug | trace | silent.
API_LOG_LEVEL=info

# Allowed browser origins for API calls. Comma-separated list.
# Use the public URL of the web frontend, e.g. http://localhost:3080
CORS_ORIGIN=http://localhost:5173,http://localhost:3080

# Trust X-Forwarded-* headers of the reverse proxy (needed for correct client
# IPs in rate limiting). Enabled by the Compose stack.
TRUST_PROXY=false

# REQUIRED. Secret used to sign session cookies. Minimum 32 characters.
# Generated by "npm run env:create".
SESSION_SECRET=change-me-session-secret-at-least-32-chars

# Lifetime of a session in hours.
SESSION_TTL_HOURS=72

# Send cookies only over HTTPS (set to true behind an HTTPS reverse proxy).
COOKIE_SECURE=false

# Cookie SameSite policy: lax | strict | none.
COOKIE_SAME_SITE=lax

# Rate limit: requests per client per window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Login rate limit per IP (specs/01-rbac.md §3.6). The production default is 5 per
# minute; the throwaway E2E API raises it so sequential E2E sign-ins never trip
# `rate_limited`.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# Altcha captcha (spam protection of the report form, WP-M2-07b)
# ---------------------------------------------------------------------------
# HMAC key of the proof-of-work challenge. Empty means "no captcha": a report the
# throttle considers suspicious is then stored as suspected spam instead of asking
# for a proof of work, so a missing value never loses a report.
ALTCHA_SECRET=

# Proof-of-work difficulty: the browser searches a counter below this number.
ALTCHA_MAX_NUMBER=10000

# ---------------------------------------------------------------------------
# Uploads (photos of the report form)
# ---------------------------------------------------------------------------
# Directory for uploaded files. Compose overrides it with /data/uploads and
# mounts a persistent volume there.
UPLOAD_DIR=data/uploads

# Maximum size of a single upload in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Volumes (persistent data)
# ---------------------------------------------------------------------------
# Names of the Docker volumes. Change them to keep several installations
# apart on the same host.
PGDATA_VOLUME=stoerdesk_pgdata
UPLOADS_VOLUME=stoerdesk_uploads
BACKUP_VOLUME=stoerdesk_backups

# ---------------------------------------------------------------------------
# Backups (profile "backup")
# ---------------------------------------------------------------------------
# Seconds between two database dumps.
BACKUP_INTERVAL_SECONDS=86400

# Days a dump is kept before it is deleted. Also bounds the pre-migration
# dumps that every compose deployment writes before the API migrates.
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# StörDesk ships no notification servers. Every channel talks to an instance
# that already exists: an ntfy server, a signal-cli bridge, a Matrix
# homeserver, a mail server or Telegram. A channel stays disabled while its
# address is empty.

# --- e-mail (SMTP) ---
# Leave the host empty to disable the e-mail channel; a channel also needs SMTP_FROM,
# the sender address the mail is signed with. `SMTP_SECURE=true` connects already
# encrypted (465), `false` upgrades on the way (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=stoerdesk@example.org

# --- ntfy ---
# URL the API publishes to, e.g. https://ntfy.sh or your own server.
NTFY_URL=https://ntfy.sh

# Public URL of the ntfy server (used by the browser to subscribe).
NTFY_PUBLIC_URL=https://ntfy.sh

# Topic new tickets are published to.
NTFY_TOPIC=stoerdesk

# Public URL of the StörDesk PWA; used as the link target of ntfy action links.
PWA_URL=

# Access level for clients without credentials: read-write | read | write | deny.
NTFY_AUTH_DEFAULT_ACCESS=read-write

# --- Telegram ---
# Leave the token empty to disable the Telegram channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Signal ---
# URL of an existing signal-cli JSON-RPC bridge. Empty disables the channel.
SIGNAL_CLI_URL=

# Own phone number of the bridge in international format, e.g. +49123456789.
SIGNAL_SOURCE_NUMBER=

# Recipients of new-ticket notifications, comma-separated.
SIGNAL_RECIPIENTS=

# --- Matrix ---
# URL of an existing Matrix homeserver, e.g. https://matrix.org.
MATRIX_HOMESERVER=

# Room ID the notifications are sent to, e.g. !abcdef:example.org
MATRIX_ROOM_ID=

# Access token of that user (created in the Matrix client).
MATRIX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# BMAcloud object sync (ADR-0003, specs/17-bmacloud-sync.md)
# ---------------------------------------------------------------------------
# Daily read-only pull of the BMAcloud Anlagen into the object list. Only GET is
# used; nothing is ever written into BMAcloud. No key at all disables the sync and
# makes the manual trigger answer `bma_not_configured`.
#   BMA_API_BASE_URL: base URL of API v2
#   BMA_API_KEY:      bearer key of the tenant (fallback, see below)
# The key is read from the `settings` row `bma.api.key` first — the admin sets it
# on the page `/admin/bma-sync` (ADR-0005) — and from here otherwise. Never commit
# it, never log it, never echo it back to the browser.
BMA_API_BASE_URL=https://bmacloud.de/api/v2/
BMA_API_KEY=

# Start the daily pull on API start. The admin can override both values from the
# sync page; they are stored as the settings `bma.sync.enabled` and `bma.sync.cron`.
BMA_SYNC_ENABLED=true
BMA_SYNC_CRON=15 3 * * *

# ---------------------------------------------------------------------------
# Web push (VAPID)
# ---------------------------------------------------------------------------
# Leave empty to disable web push. Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ---------------------------------------------------------------------------
# Update control (ADR-0007)
# ---------------------------------------------------------------------------
# The administration checks GitHub for a newer commit and starts the deployment
# through a webhook. Both keys stay in the API container: they are never sent to
# the browser and never written to a log line.

# The upstream repository as owner/repo. Empty disables the update check.
GITHUB_REPO=

# The branch with the newest sources.
GITHUB_BRANCH=main

# Optional personal access token of the GitHub API. It raises the rate limit of
# the anonymous requests; an empty value works for a public repository.
GITHUB_TOKEN=

# The deploy hook the start of an update calls, for example the webhook of a
# panel. Empty disables the start; the check keeps working.
UPDATE_WEBHOOK_URL=http://host.docker.internal:9000/hooks/deploy

# The value of the `X-Deploy-Token` header of the webhook. Use a long random
# value; it is the only secret of this feature.
UPDATE_WEBHOOK_TOKEN=

# The commit the `api` image was built from. It is a build argument of the
# compose file; when it stays `unknown`, the API reads the version of the
# tracked `VERSION` file of the image.
GIT_COMMIT=unknown

# ---------------------------------------------------------------------------
# Seed data (initial administrator, WP-M1-06)
# ---------------------------------------------------------------------------
# Bootstrap administrator created by `npx tsx src/db/seed-base.ts`, which links
# the account to the system role `admin`. Both values must be set together; the
# password needs at least 12 characters. When both are empty the seed skips and
# the account has to be created through the admin UI. The e-mail is stored lower
# case. Seed order: migrate, seed-rbac, seed-base.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me-admin-password

# The version shown in the app shell is not configured here: it comes from the
# tracked `VERSION` file, which the commit hooks keep in sync with the git tags
# of this repository.

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Postgres for the API integration tests. Without a reachable database the
# tests are skipped. Falls back to DATABASE_URL when empty.
# The account must be able to create its own databases so the migration runs
# against an empty one; otherwise the given database is used directly.
TEST_DATABASE_URL=postgres://stoerdesk:change-me-postgres@localhost:5432/stoerdesk
